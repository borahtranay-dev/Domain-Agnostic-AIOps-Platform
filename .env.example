# ==============================================================================
# AIOps Self-Healing Platform — Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT SENSITIVE SECRETS TO SOURCE CONTROL
# Copy this file to .env for local development

# Database Configuration (PostgreSQL)
POSTGRES_USER=aiops_user
POSTGRES_PASSWORD=aiops_password
POSTGRES_DB=aiops_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Message Queue & Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Service Ports (Host bindings)
API_PORT=8000
AI_WORKER_PORT=8001
WEB_PORT=3000

# Inter-Service URLs (Internal container network)
API_INTERNAL_URL=http://api:8000
AI_WORKER_INTERNAL_URL=http://ai-worker:8001

# Public URLs (Browser-facing)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AI_WORKER_URL=http://localhost:8001

# Logging
LOG_LEVEL=INFO
